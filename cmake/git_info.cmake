# Writes the header that records which commit flint_bench was built from.
# Usage: cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P git_info.cmake
# Outside a git checkout (a `git archive` copy, or no git at all) the SHA is
# "unknown" and the tree counts as clean.
if(NOT SOURCE_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "git_info.cmake needs -DSOURCE_DIR and -DOUTPUT")
endif()

set(sha "unknown")
set(dirty 0)
find_program(GIT_EXECUTABLE git)
# A directory inside some other repository doesn't count: only a .git here does.
if(GIT_EXECUTABLE AND EXISTS "${SOURCE_DIR}/.git")
  execute_process(
    COMMAND ${GIT_EXECUTABLE} -C "${SOURCE_DIR}" rev-parse HEAD
    RESULT_VARIABLE head_result
    OUTPUT_VARIABLE head_output
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
  )
  if(head_result EQUAL 0 AND head_output MATCHES "^[0-9a-f]+$")
    set(sha "${head_output}")
    execute_process(
      COMMAND ${GIT_EXECUTABLE} -C "${SOURCE_DIR}" --no-optional-locks status --porcelain
      RESULT_VARIABLE status_result
      OUTPUT_VARIABLE status_output
      ERROR_QUIET
    )
    if(status_result EQUAL 0 AND NOT status_output STREQUAL "")
      set(dirty 1)
    endif()
  endif()
endif()

set(content "// Generated by cmake/git_info.cmake; do not edit.\n#pragma once\n#define FLINT_GIT_SHA \"${sha}\"\n#define FLINT_GIT_DIRTY ${dirty}\n")

# Rewrite only on a change, so the objects that include it don't rebuild.
set(existing "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
